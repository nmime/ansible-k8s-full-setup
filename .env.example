# Environment variables required by ansible-k8s-full-setup
# Usage: cp .env.example .env && edit values && source .env

# Hetzner Cloud API token (server provisioning)
# HCLOUD_TOKEN=

# Gcore CDN API key (edge DNS/CDN)
# GCORE_API_KEY=

# GitHub token (GitLab mirror sync)
# GITHUB_TOKEN=

# SeaweedFS root credentials (object storage)
# OBJECT_STORAGE_ACCESS_KEY (or legacy MINIO_ROOT_USER)=
# OBJECT_STORAGE_SECRET_KEY (or legacy MINIO_ROOT_PASSWORD)=

# Alerting config
# ALERT_EMAIL_TO=
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
