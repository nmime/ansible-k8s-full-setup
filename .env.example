# Environment variables required by ansible-k8s-full-setup
# Usage: cp .env.example .env && chmod 600 .env && edit values
# Operational scripts load this gitignored file automatically. Variables that
# are already exported by the caller take precedence over values in this file.

# Hetzner Cloud API token (server provisioning)
# HCLOUD_TOKEN=

# Comma-separated operator/VPN CIDRs allowed to reach bastion SSH. Public
# 0.0.0.0/0 and ::/0 are rejected by the infrastructure role.
# HETZNER_SSH_SOURCE_IPS=203.0.113.10/32,2001:db8::10/128

# Hetzner exposes volume usage but no account-quota API. Set the exact quota
# shown for this account; live profile migration fails closed without it.
# PROFILE_MIGRATION_HCLOUD_VOLUME_QUOTA_GIB=1500
# PROFILE_MIGRATION_VOLUME_SAFETY_MARGIN_GIB=100

# Gcore CDN API key (edge DNS/CDN)
# GCORE_API_KEY=

# GitHub token (GitLab mirror sync)
# GITHUB_TOKEN=

# Existing GitLab Runner authentication token for profiles that enable Runner.
# Create an instance runner in GitLab Admin > CI/CD > Runners; legacy
# registration tokens are rejected. The value is copied into the
# Ansible Vault-encrypted platform secrets file for repeat reconciliations.
# GITLAB_RUNNER_TOKEN=glrt-...

# Separate protected instance runner for rootless BuildKit image jobs. It is
# scoped to the image-build tag, refuses untagged jobs, and is persisted only
# in the Ansible Vault-encrypted platform secrets file.
# GITLAB_IMAGE_BUILDER_RUNNER_TOKEN=glrt-...

# Separate protected runner for the legacy docker-host CI tag. Jobs execute in
# Kubernetes; only the pinned Docker-in-Docker service is privileged.
# GITLAB_DOCKER_HOST_RUNNER_TOKEN=glrt-...

# SeaweedFS object storage credentials
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=

# Independent external disaster-recovery object storage (never in-cluster)
# BACKUP_DR_ENDPOINT=https://s3.example-provider.com
# BACKUP_DR_ALLOW_LITERAL_IP=false
# Optional controller-only route to the same S3 service, such as a local tunnel.
# BACKUP_DR_CLIENT_ENDPOINT=http://127.0.0.1:19000
# BACKUP_DR_REGION=us-east-1
# BACKUP_DR_BUCKET=company-platform-dr
# BACKUP_DR_PREFIX=k8s/velero
# BACKUP_DR_ACCESS_KEY=
# BACKUP_DR_SECRET_KEY=

# Encrypt full-cluster bundles with one method. Prefer an age recipient.
# CLUSTER_BACKUP_AGE_RECIPIENT=age1...
# CLUSTER_BACKUP_AGE_IDENTITY=/secure/path/to/age-identity.txt
# CLUSTER_BACKUP_PASSPHRASE=

# Local path to the Ansible Vault password (the password file stays outside Git)
# ANSIBLE_VAULT_PASSWORD_FILE=/secure/path/to/ansible-vault-password

# Alerting config
# ALERT_EMAIL_TO=
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# Optional dedicated Telegram destination for the Helsinki CX capacity monitor.
# When omitted, scripts/notify-cx-capacity-telegram.sh reuses the two
# ALERT_TELEGRAM_* values above.
# CX_CAPACITY_TELEGRAM_BOT_TOKEN=
# CX_CAPACITY_TELEGRAM_CHAT_ID=
