services:
  headscale:
    container_name: headscale
    image: headscale/headscale:{{ headscale_version }}
    restart: always
    command: serve
    ports:
      - "127.0.0.1:9090:9090"
      - "3478:3478/udp"
    volumes:
      - /var/lib/headscale:/var/lib/headscale
      - /etc/headscale:/etc/headscale:ro
    environment:
      - TZ=UTC
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
      - /run
      - /var/run/headscale
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "headscale", "health"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 10s
  caddy:
    container_name: caddy
    image: caddy:{{ caddy_image_tag }}
    restart: always
    ports:
      - "127.0.0.1:8443:443"
      - "127.0.0.1:8080:80"
    volumes:
      - /opt/headscale/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      headscale:
        condition: service_healthy
    security_opt:
      - no-new-privileges:true
    read_only: true
    tmpfs:
      - /tmp
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    healthcheck:
      test: ["CMD", "caddy", "version"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 10s
volumes:
  caddy_data:
  caddy_config:
