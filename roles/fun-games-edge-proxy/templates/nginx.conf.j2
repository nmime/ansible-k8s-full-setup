pid /tmp/nginx.pid;
error_log /dev/stderr notice;

events {
  worker_connections 4096;
}

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log /dev/stdout;
  server_tokens off;
  resolver {{ fun_games_edge_resolvers | join(' ') }} valid=30s ipv6=off;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    "" close;
  }

  # Unknown authorities must never fall through to the first application.
  server {
    listen 8080 default_server;
    server_name _;
    return 444;
  }

  server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
  }

{% for edge_host in fun_games_edge_hosts %}
  server {
    listen 8080;
    server_name {{ edge_host.hostname }};

    # Edge Certbot challenges are served from the local webroot. A token that
    # is not local belongs to the origin cert-manager solver and is proxied,
    # so both independently managed certificate sets keep renewing.
    location ^~ /.well-known/acme-challenge/ {
      root /var/www/acme;
      try_files $uri @origin_acme;
    }

    location @origin_acme {
      set $edge_upstream "{{ edge_host.upstream_host }}";
      proxy_pass https://$edge_upstream{% if edge_host.upstream_port | default(443) | int != 443 %}:{{ edge_host.upstream_port }}{% endif %};
      proxy_ssl_server_name on;
      proxy_ssl_name {{ edge_host.upstream_sni | default(edge_host.upstream_host) }};
      proxy_ssl_verify on;
      proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
      proxy_ssl_verify_depth 3;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto http;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
      return 308 https://$host$request_uri;
    }
  }

  server {
    listen 8443 ssl;
    server_name {{ edge_host.hostname }};

    ssl_certificate /etc/nginx/edge-certs/{{ edge_host.hostname }}.crt;
    ssl_certificate_key /etc/nginx/edge-certs/{{ edge_host.hostname }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age={{ fun_games_edge_hsts_max_age }}" always;

    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_connect_timeout {{ fun_games_edge_proxy_connect_timeout }};
    proxy_read_timeout {{ fun_games_edge_proxy_read_timeout }};
    proxy_send_timeout {{ fun_games_edge_proxy_send_timeout }};

    location = /_edge/health {
      access_log off;
      return 204;
    }

    location / {
      set $edge_upstream "{{ edge_host.upstream_host }}";
      proxy_pass https://$edge_upstream{% if edge_host.upstream_port | default(443) | int != 443 %}:{{ edge_host.upstream_port }}{% endif %};
      proxy_ssl_server_name on;
      proxy_ssl_name {{ edge_host.upstream_sni | default(edge_host.upstream_host) }};
      proxy_ssl_verify on;
      proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
      proxy_ssl_verify_depth 3;
      proxy_hide_header Server;

      # Preserve the public authority. AWS SigV4 signs the Host header and
      # Colyseus/API callers also depend on the original authority.
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Forwarded-Port 443;
      # This is the outermost trusted proxy. Never inherit a client-supplied
      # forwarding chain.
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_pass_request_headers on;
    }
  }
{% endfor %}
}
