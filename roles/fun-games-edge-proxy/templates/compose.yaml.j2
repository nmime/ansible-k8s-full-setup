services:
  proxy:
    image: "{{ fun_games_edge_image }}"
    restart: unless-stopped
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    group_add:
      - "{{ fun_games_edge_tls_group_gid }}"
    cpus: "{{ fun_games_edge_container_cpus }}"
    mem_limit: "{{ fun_games_edge_container_memory }}"
    pids_limit: {{ fun_games_edge_container_pids_limit }}
    ports:
{% if fun_games_edge_mode == 'canary' %}
      - "127.0.0.1:{{ fun_games_edge_canary_http_port }}:8080"
      - "127.0.0.1:{{ fun_games_edge_canary_https_port }}:8443"
{% else %}
      - "0.0.0.0:{{ fun_games_edge_http_port }}:8080"
      - "0.0.0.0:{{ fun_games_edge_https_port }}:8443"
{% endif %}
    volumes:
      - "{{ fun_games_edge_install_root }}/nginx.conf:/etc/nginx/nginx.conf:ro"
      - "{{ fun_games_edge_install_root }}/certs:/etc/nginx/edge-certs:ro"
      - "{{ fun_games_edge_acme_webroot }}:/var/www/acme:ro"
    tmpfs:
      - /tmp
      - /var/cache/nginx
      - /var/run
    healthcheck:
      test: ["CMD", "nginx", "-t"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5s
    logging:
      driver: json-file
      options:
        max-size: 20m
        max-file: "5"
