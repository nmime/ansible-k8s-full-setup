#!/usr/bin/env python3
"""Hetzner Floating-IP and Network-route failover controller."""

from __future__ import annotations

import argparse
import fcntl
import json
import os
from pathlib import Path
import sys
import time
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

CONFIG_PATH = Path("/etc/platform-egress.json")
LOCK_PATH = Path("/run/lock/platform-egress.lock")


class Controller:
    def __init__(self) -> None:
        self.config = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        self.token = Path(self.config["token_file"]).read_text(encoding="utf-8").strip()
        self.endpoint = self.config["api_endpoint"].rstrip("/")
        self.gateways = {item["name"]: item for item in self.config["gateways"]}
        self.gateways_by_ip = {item["private_ip"]: item for item in self.config["gateways"]}
        self.state_path = Path(self.config["state_file"])

    def request(self, method: str, path: str, payload: dict | None = None) -> dict:
        body = json.dumps(payload).encode() if payload is not None else None
        req = Request(
            f"{self.endpoint}{path}", data=body, method=method,
            headers={"Authorization": f"Bearer {self.token}", "Content-Type": "application/json"},
        )
        try:
            with urlopen(req, timeout=10) as response:
                return json.load(response)
        except HTTPError as exc:
            detail = exc.read().decode(errors="replace")
            raise RuntimeError(f"Hetzner API {method} {path} failed: HTTP {exc.code}: {detail}") from exc

    def wait_action(self, document: dict, timeout: int = 90) -> None:
        action = document.get("action")
        if not action:
            return
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            current = self.request("GET", f"/actions/{action['id']}")["action"]
            if current["status"] == "success":
                return
            if current["status"] == "error":
                raise RuntimeError(f"Hetzner action {current['id']} failed: {current.get('error')}")
            time.sleep(1)
        raise TimeoutError(f"Hetzner action {action['id']} exceeded {timeout}s")

    def provider_state(self) -> dict:
        network = self.request("GET", f"/networks/{self.config['network_id']}")["network"]
        floating = self.request("GET", f"/floating_ips/{self.config['floating_ip_id']}")["floating_ip"]
        default_routes = [route for route in network.get("routes", []) if route["destination"] == "0.0.0.0/0"]
        if len(default_routes) != 1:
            raise RuntimeError(f"expected exactly one default route, found {default_routes}")
        gateway_ip = default_routes[0]["gateway"]
        if gateway_ip not in self.gateways_by_ip:
            raise RuntimeError(f"default route points to unmanaged gateway {gateway_ip}")
        return {
            "route_gateway": gateway_ip,
            "active_gateway": self.gateways_by_ip[gateway_ip],
            "floating_server_id": floating["server"],
            "floating_ip": floating["ip"],
        }

    def health(self, gateway: dict, endpoint: str) -> bool:
        url = f"http://{gateway['private_ip']}:{self.config['health_port']}/{endpoint}"
        try:
            with urlopen(url, timeout=self.config["health_timeout_seconds"]) as response:
                return response.status == 200
        except (HTTPError, URLError, TimeoutError, OSError):
            return False

    def change_route(self, old_gateway: str, new_gateway: str) -> None:
        if old_gateway == new_gateway:
            return
        self.wait_action(self.request(
            "POST", f"/networks/{self.config['network_id']}/actions/delete_route",
            {"destination": "0.0.0.0/0", "gateway": old_gateway},
        ))
        self.wait_action(self.request(
            "POST", f"/networks/{self.config['network_id']}/actions/add_route",
            {"destination": "0.0.0.0/0", "gateway": new_gateway},
        ))

    def assign_floating(self, server_id: int) -> None:
        current = self.request("GET", f"/floating_ips/{self.config['floating_ip_id']}")["floating_ip"]
        if current["server"] == server_id:
            return
        self.wait_action(self.request(
            "POST", f"/floating_ips/{self.config['floating_ip_id']}/actions/assign", {"server": server_id},
        ))

    def promote(self, target_name: str) -> dict:
        if target_name not in self.gateways:
            raise RuntimeError(f"unknown gateway {target_name}; choose from {sorted(self.gateways)}")
        target = self.gateways[target_name]
        if not self.health(target, "readyz"):
            raise RuntimeError(f"target {target_name} is not ready; refusing failover")
        server = self.request("GET", f"/servers/{target['server_id']}")["server"]
        if server["status"] != "running":
            raise RuntimeError(f"target {target_name} provider status is {server['status']}")
        before = self.provider_state()
        if before["route_gateway"] == target["private_ip"] and before["floating_server_id"] == target["server_id"]:
            return before
        previous = before["active_gateway"]
        try:
            self.assign_floating(target["server_id"])
            self.change_route(before["route_gateway"], target["private_ip"])
            deadline = time.monotonic() + self.config["promotion_timeout_seconds"]
            while time.monotonic() < deadline:
                if self.health(target, "healthz"):
                    after = self.provider_state()
                    if after["route_gateway"] == target["private_ip"] and after["floating_server_id"] == target["server_id"]:
                        return after
                time.sleep(2)
            raise RuntimeError(f"target {target_name} did not become healthy after promotion")
        except Exception:
            current = self.provider_state()
            self.assign_floating(previous["server_id"])
            self.change_route(current["route_gateway"], previous["private_ip"])
            raise

    def load_state(self) -> dict:
        try:
            return json.loads(self.state_path.read_text(encoding="utf-8"))
        except (FileNotFoundError, json.JSONDecodeError):
            return {"consecutive_failures": 0, "failovers_total": 0}

    def save_state(self, state: dict) -> None:
        self.state_path.parent.mkdir(parents=True, exist_ok=True)
        temporary = self.state_path.with_suffix(".tmp")
        temporary.write_text(json.dumps(state, sort_keys=True) + "\n", encoding="utf-8")
        os.replace(temporary, self.state_path)

    def watchdog(self) -> dict:
        state = self.load_state()
        provider = self.provider_state()
        local_ip = self.config["local_private_ip"]
        if provider["route_gateway"] == local_ip:
            state["consecutive_failures"] = 0
            self.save_state(state)
            return {"role": "active", **provider}
        if self.health(provider["active_gateway"], "healthz"):
            state["consecutive_failures"] = 0
            self.save_state(state)
            return {"role": "standby", "peer_healthy": True, **provider}
        state["consecutive_failures"] = int(state.get("consecutive_failures", 0)) + 1
        self.save_state(state)
        if state["consecutive_failures"] < self.config["failure_threshold"]:
            raise RuntimeError(
                f"active health failed {state['consecutive_failures']}/{self.config['failure_threshold']} times"
            )
        target = self.gateways_by_ip[local_ip]
        promoted = self.promote(target["name"])
        state["consecutive_failures"] = 0
        state["failovers_total"] = int(state.get("failovers_total", 0)) + 1
        state["last_failover_unix"] = int(time.time())
        self.save_state(state)
        return {"role": "promoted", **promoted}


def main() -> int:
    parser = argparse.ArgumentParser()
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("status")
    promote = sub.add_parser("promote")
    promote.add_argument("gateway")
    sub.add_parser("watchdog")
    args = parser.parse_args()
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w", encoding="utf-8") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        controller = Controller()
        if args.command == "status":
            result = controller.provider_state()
        elif args.command == "promote":
            result = controller.promote(args.gateway)
        else:
            result = controller.watchdog()
        print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # systemd records the complete reason without leaking the token.
        print(f"platform-egressctl: {exc}", file=sys.stderr)
        raise SystemExit(1)
