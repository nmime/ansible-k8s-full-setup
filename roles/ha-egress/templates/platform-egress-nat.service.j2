[Unit]
Description=platform static Floating-IP SNAT gateway
After=network-online.target
Wants=network-online.target
Before=platform-egress-health.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/platform-egress-nat {{ 'activate' if ha_egress_activate | bool else 'prepare' }}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
