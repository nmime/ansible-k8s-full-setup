proxy_cache_path {{ edge_cache_path }} levels=1:2 keys_zone=edge_cache:10m max_size={{ edge_cache_size }} inactive=7d use_temp_path=off;

upstream origin {
    server {{ edge_upstream_host }}:{{ edge_upstream_port }};
    keepalive 32;
}

server {
    listen 80;
    server_name {{ edge_subdomain }}.{{ edge_domain }} {{ edge_domain }} *.{{ edge_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ edge_subdomain }}.{{ edge_domain }} {{ edge_domain }} *.{{ edge_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ edge_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ edge_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    add_header X-Cache-Status $upstream_cache_status;
    add_header X-Edge-Region {{ edge_region_name }};
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    location /health {
        access_log off;
        return 200 '{"status":"ok","region":"{{ edge_region_name }}"}';
        add_header Content-Type application/json;
    }

    location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff2?|svg|webp|avif)$ {
        proxy_pass https://origin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_cache edge_cache;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;
        proxy_cache_key $scheme$host$request_uri;

        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(html|htm)$ {
        proxy_pass https://origin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_cache edge_cache;
        proxy_cache_valid 200 1h;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;

        expires 1h;
    }

    location / {
        proxy_pass https://origin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_cache edge_cache;
        proxy_cache_valid 200 10m;
        proxy_cache_valid 301 302 1h;
        proxy_cache_valid 404 1m;
        proxy_cache_bypass $http_cache_control;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;

        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
    }

    location /api/ {
        proxy_pass https://origin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_cache off;
        proxy_buffering off;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location ~* /purge(/.*) {
        allow 127.0.0.1;
{% for ip in edge_purge_allowed_ips | default(['10.0.0.0/8']) %}
        allow {{ ip }};
{% endfor %}
        deny all;
        proxy_cache_purge edge_cache $scheme$host$1;
    }
}
