---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: e2b-client-proxy
  namespace: {{ e2b_ns }}
  labels:
    app.kubernetes.io/name: e2b-client-proxy
    app.kubernetes.io/part-of: e2b
spec:
  replicas: {{ e2b_cp_replicas_val }}
  selector:
    matchLabels:
      app.kubernetes.io/name: e2b-client-proxy
  template:
    metadata:
      labels:
        app.kubernetes.io/name: e2b-client-proxy
        app.kubernetes.io/part-of: e2b
    spec:
      containers:
        - name: client-proxy
          image: e2b-client-proxy:{{ e2b_version | default('latest') }}
          command: ["/opt/e2b/bin/client-proxy"]
          ports:
            - containerPort: {{ e2b_client_proxy_port | default(3002) }}
              name: proxy
              protocol: TCP
            - containerPort: {{ e2b_client_proxy_health_port | default(3003) }}
              name: health
              protocol: TCP
          env:
            - name: ENVIRONMENT
              value: "{{ tier | default('production') }}"
            - name: NODE_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                name: e2b-config
                  key: REDIS_URL
            - name: API_GRPC_ADDRESS
              value: "e2b-api.{{ e2b_ns }}.svc.cluster.local:5009"
          resources:
            requests:
              cpu: "{{ e2b_client_proxy_cpu_request | default('100m') }}"
              memory: "{{ e2b_client_proxy_memory_request | default('128Mi') }}"
            limits:
              cpu: "{{ e2b_client_proxy_cpu_limit | default('500m') }}"
              memory: "{{ e2b_client_proxy_memory_limit | default('512Mi') }}"
          readinessProbe:
            httpGet:
              path: /
              port: {{ e2b_client_proxy_health_port | default(3003) }}
            initialDelaySeconds: 5
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: {{ e2b_client_proxy_health_port | default(3003) }}
            initialDelaySeconds: 15
            periodSeconds: 30
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: e2b-client-proxy
  namespace: {{ e2b_ns }}
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: e2b-client-proxy
  minReplicas: {{ e2b_cp_replicas_val }}
  maxReplicas: {{ (e2b_cp_replicas_val | int) * 4 }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
