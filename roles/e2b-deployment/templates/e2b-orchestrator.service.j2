[Unit]
Description=E2B Orchestrator - Firecracker Sandbox Manager
After=network-online.target
Wants=network-online.target
ConditionPathExists=/dev/kvm

[Service]
Type=simple
EnvironmentFile=/opt/e2b/orchestrator.env
ExecStart=/opt/e2b/bin/orchestrator
Restart=on-failure
RestartSec=10
LimitNOFILE=65536
LimitNPROC=4096

WorkingDirectory={{ e2b_orchestrator_base_dir | default('/opt/e2b/orchestrator') }}

CPUQuota={{ e2b_max_concurrent_sandboxes | default(20) * 5 }}%
MemoryMax={{ e2b_hugepages_count | default(2048) * 2 + 2048 }}M

ProtectSystem=false
ProtectHome=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
