---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: e2b-api
  namespace: {{ e2b_ns }}
  labels:
    app.kubernetes.io/name: e2b-api
    app.kubernetes.io/part-of: e2b
    app.kubernetes.io/version: "{{ e2b_version | default('0.1.4') }}"
    app.kubernetes.io/managed-by: ansible
spec:
  replicas: {{ e2b_api_replicas_val }}
  selector:
    matchLabels:
      app.kubernetes.io/name: e2b-api
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 1
      maxUnavailable: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: e2b-api
        app.kubernetes.io/part-of: e2b
        app.kubernetes.io/version: "{{ e2b_version | default('0.1.4') }}"
      annotations:
        checksum/config: "{{ e2b_config_checksum | default('') }}"
    spec:
      serviceAccountName: e2b-api
      containers:
        - name: api
          image: "{{ e2b_image_registry | default('registry.' + domain) }}/e2b/api:{{ e2b_image_tag | default(e2b_version | default('0.1.4')) }}"
          ports:
            - containerPort: {{ e2b_api_port | default(3000) }}
              name: http
              protocol: TCP
            - containerPort: {{ e2b_api_grpc_port | default(5009) }}
              name: grpc
              protocol: TCP
          env:
            - name: ENVIRONMENT
              value: "{{ tier | default('production') }}"
            - name: NODE_ID
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: POSTGRES_CONNECTION_STRING
              valueFrom:
                secretKeyRef:
                  name: e2b-config
                  key: POSTGRES_CONNECTION_STRING
            - name: REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: e2b-config
                  key: REDIS_URL
            - name: CLICKHOUSE_CONNECTION_STRING
              valueFrom:
                secretKeyRef:
                  name: e2b-config
                  key: CLICKHOUSE_CONNECTION_STRING
            - name: ADMIN_TOKEN
              valueFrom:
                secretKeyRef:
                  name: e2b-config
                  key: ADMIN_TOKEN
            - name: DOMAIN_NAME
              value: "{{ domain | default('') }}"
            - name: API_GRPC_PORT
              value: "{{ e2b_api_grpc_port | default(5009) }}"
            - name: LOKI_URL
              value: "http://loki.observability.svc.cluster.local:3100/loki/api/v1/push"
            - name: STORAGE_PROVIDER
              value: "{{ e2b_storage_provider | default('Local') }}"
          resources:
            requests:
              cpu: "{{ e2b_api_cpu_request | default('200m') }}"
              memory: "{{ e2b_api_memory_request | default('256Mi') }}"
            limits:
              cpu: "{{ e2b_api_cpu_limit | default('1000m') }}"
              memory: "{{ e2b_api_memory_limit | default('1Gi') }}"
          readinessProbe:
            httpGet:
              path: /health
              port: {{ e2b_api_port | default(3000) }}
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /health
              port: {{ e2b_api_port | default(3000) }}
            initialDelaySeconds: 30
            periodSeconds: 30
      imagePullSecrets:
        - name: registry-credentials
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: e2b-api
  namespace: {{ e2b_ns }}
  labels:
    app.kubernetes.io/name: e2b-api
    app.kubernetes.io/part-of: e2b
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: e2b-api
  namespace: {{ e2b_ns }}
  labels:
    app.kubernetes.io/name: e2b-api
    app.kubernetes.io/part-of: e2b
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: e2b-api
  minReplicas: {{ e2b_api_replicas_val }}
  maxReplicas: {{ (e2b_api_replicas_val | int) * 4 }}
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
    - type: Resource
      resource:
        name: memory
        target:
          type: Utilization
          averageUtilization: 80
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: e2b-api
  namespace: {{ e2b_ns }}
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: e2b-api
