ENVIRONMENT={{ tier | default('production') }}
E2B_DEBUG=false
NODE_ID={{ inventory_hostname }}
NODE_IP={{ ansible_host | default(inventory_hostname) }}

# Orchestrator services
ORCHESTRATOR_SERVICES=orchestrator

# Paths
ORCHESTRATOR_BASE_PATH={{ e2b_orchestrator_base_dir | default('/opt/e2b/orchestrator') }}
SANDBOX_DIR={{ e2b_sandbox_dir | default('/opt/e2b/fc-vm') }}
HOST_KERNELS_DIR={{ e2b_kernels_dir | default('/opt/e2b/fc-kernels') }}
FIRECRACKER_VERSIONS_DIR={{ e2b_firecracker_dir | default('/opt/e2b/fc-versions') }}
HOST_BUSYBOX_DIR={{ e2b_busybox_dir | default('/opt/e2b/fc-busybox') }}
HOST_ENVD_PATH={{ e2b_envd_dir | default('/opt/e2b/fc-envd') }}/envd
TEMPLATES_DIR={{ e2b_templates_dir | default('/opt/e2b/templates') }}

# Storage
STORAGE_PROVIDER={{ e2b_storage_provider | default('Local') }}
SANDBOX_CACHE_DIR={{ e2b_sandbox_cache_dir | default('/opt/e2b/sandbox-cache') }}
SNAPSHOT_CACHE_DIR={{ e2b_snapshot_cache_dir | default('/opt/e2b/snapshot-cache') }}
TEMPLATE_CACHE_DIR={{ e2b_template_cache_dir | default('/opt/e2b/template-cache') }}
SHARED_CHUNK_CACHE_PATH={{ e2b_shared_chunk_cache_dir | default('/opt/e2b/chunk-cache') }}

# Networking
GRPC_PORT={{ e2b_orchestrator_grpc_port | default(5008) }}
PROXY_PORT={{ e2b_orchestrator_proxy_port | default(5007) }}

# Database
POSTGRES_CONNECTION_STRING={{ e2b_pg_conn | default('') }}
CLICKHOUSE_CONNECTION_STRING={{ e2b_clickhouse_conn | default('') }}

# Redis
REDIS_URL={{ e2b_redis_url_val | default('') }}
REDIS_POOL_SIZE=10

# NBD
NBD_POOL_SIZE={{ e2b_nbd_max_devices | default(64) }}

# Domain
DOMAIN_NAME={{ domain | default('') }}

# Node labels
NODE_LABELS=tier:{{ tier }},node:{{ inventory_hostname }}

# Logs
LOKI_URL=http://loki.observability.svc.cluster.local:3100/loki/api/v1/push
