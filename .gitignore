# Platform secrets (auto-generated credentials)
.platform-secrets.yml
.object-storage-credentials
.vault-init.json
.vault-init-*.json

# GitLab license (generated keys and license files)
.gitlab-license/

# Infrastructure state (contains IPs)
*-infra-facts.yml

# Platform orchestrator state and logs
platform-orchestrator/.state/
platform-orchestrator/logs/
platform-orchestrator/platform.yaml

# Encrypted local disaster-recovery bundles and resumable migration state
cluster-backups/
.migration-state/
snapshot/
.backup-results-*.log

# Ansible retry files
*.retry

# Kubespray
kubespray/

# Python
*.pyc
__pycache__/
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Terraform state (if used)
*.tfstate
*.tfstate.backup
.terraform/
.env
