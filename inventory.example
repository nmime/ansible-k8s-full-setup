---
# ============================================
# Ansible Inventory for Kubernetes Platform
# ============================================
# Copy to inventory.yml and customize
# Usage: ansible-playbook playbooks/deploy_platform.yml -i inventory.yml
# ============================================

all:
  hosts:
    localhost:
      ansible_connection: local

  vars:
    # ----------------------------------------
    # Global Settings
    # ----------------------------------------
    domain: example.com          # REQUIRED: change to your domain
    email: admin@example.com     # REQUIRED: change to your email
    project_name: k8s
    environment: production

    # Tier selection: minimal, small, medium, production
    tier: medium

    # ----------------------------------------
    # Infrastructure (Hetzner)
    # ----------------------------------------
    hetzner_api_token: "{{ lookup('env', 'HCLOUD_TOKEN') }}"
    hetzner_region: hel1
    ssh_user: root
    ssh_key_path: ~/.ssh/id_ed25519

    # ----------------------------------------
    # Kubernetes
    # ----------------------------------------
    k8s_version: v1.34.3
    k8s_cni: cilium
    k8s_pod_cidr: 10.233.64.0/18
    k8s_service_cidr: 10.233.0.0/18

    # ----------------------------------------
    # Network
    # ----------------------------------------
    private_network_cidr: 10.0.0.0/16
    vpn_enabled: true

    # ----------------------------------------
    # Storage (MinIO)
    # ----------------------------------------
    minio_replicas: 4
    minio_storage_size: 50Gi

    # ----------------------------------------
    # Secrets (Vault + ESO)
    # ----------------------------------------
    vault_replicas: 3
    vault_storage_size: 10Gi
    eso_enabled: true

    # ----------------------------------------
    # Databases
    # ----------------------------------------
    postgresql_replicas: 2
    postgresql_storage: 20Gi
    postgresql_version: 18

    # ----------------------------------------
    # GitLab
    # ----------------------------------------
    gitlab_runner_concurrent_jobs: 10

    # ----------------------------------------
    # Observability
    # ----------------------------------------
    metrics_retention: 30d
    metrics_storage: 50Gi
    logging_retention: 14d

    # ----------------------------------------
    # Autoscaling (KEDA)
    # ----------------------------------------
    keda_enabled: true

    # ----------------------------------------
    # Backup
    # ----------------------------------------
    backup_schedule: "0 2 * * *"
    backup_retention_days: 30

    # ----------------------------------------
    # Boilerplate Application (optional)
    # ----------------------------------------
    deploy_boilerplate: false
    # app_name: myapp
    # app_namespace: production
    # git_provider: gitlab-selfhosted

    # ----------------------------------------
    # Daytona Workspaces (optional)
    # ----------------------------------------
    deploy_daytona: false
    # daytona_namespace: daytona
    # daytona_base_domain: "daytona.{{ domain }}"
    # daytona_values_override: {}
